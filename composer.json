{
    "name": "plutuss/static-text-filamentphp",
    "description": "Manage Static Text Laravel pages and localized content blocks in a Filament panel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "filament-plugin", "static-text", "content-blocks", "content-management", "localization"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "plutuss/static-text-laravel": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/plutuss/static-text.git"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\StaticTextFilament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Plutuss\\StaticTextFilament\\StaticTextFilamentServiceProvider"]
        }
    }
}
